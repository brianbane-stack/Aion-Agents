# Copie para .env.local. Não coloque segredos reais neste arquivo.

# demonstration (padrão) bloqueia Google, WhatsApp e o provedor de IA.
# live permite chamadas externas quando as credenciais abaixo existem.
APP_MODE=demonstration

# Obrigatório com pelo menos 32 caracteres quando APP_MODE=live.
# Em demonstração, se ficar vazio, o processo grava um segredo local em data/.session-secret.
SESSION_SECRET=

# true apenas em HTTPS. Em http local deixe false.
COOKIE_SECURE=false

# Caminho do SQLite. Padrão: data/vetagents.db
VETAGENTS_DB_PATH=

# Senha das contas fictícias. Se vazia, a demonstração gera data/demo-password.txt.
DEMO_USER_PASSWORD=

# Google Business Profile OAuth. Escopo: https://www.googleapis.com/auth/business.manage
# Crie o cliente em https://console.cloud.google.com/ e autorize o redirect
# {origem}/api/integrations/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# WhatsApp Cloud API. A versão padrão do código é v26.0; confirme a versão suportada
# antes de produção: https://developers.facebook.com/docs/graph-api/changelog
WHATSAPP_GRAPH_API_VERSION=v26.0

# Provedor compatível com OpenAI. A base precisa incluir /v1.
# Exemplo: https://api.openai.com/v1
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
